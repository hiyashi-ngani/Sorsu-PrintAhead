# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL Database & Storage Configuration
# If provided, the backend will sync directly with your live Supabase project.
# When omitted, the built-in resilient database engine will handle requests seamlessly.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# SorSU Identity Provider and Email Notification Configuration
SORSU_DOMAIN="sorsu.edu.ph"
EMAIL_NOTIFICATION_SENDER="printahead-noreply@sorsu.edu.ph"

# Brevo (formerly Sendinblue) Transactional Email Provider
# Obtain your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="printahead-noreply@sorsu.edu.ph"
BREVO_SENDER_NAME="SorSU: PrintAhead (Bulan Campus)"
